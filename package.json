{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "format": "oxfmt",
    "test": "pnpm run test:ocr",
    "test:ocr": "pnpm exec tsc src/lib/cardOcr.ts --outDir scripts-build/ocr-test-run --module commonjs --target es2022 --skipLibCheck && ren scripts-build\\ocr-test-run\\cardOcr.js cardOcr.cjs && node scripts-build/ocr-test-run/ocr-test-run.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@supabase/supabase-js": "^2.117.1",
    "ethers": "^6.17.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}

# Copy to .env and fill in. Never commit the real .env (already gitignored).
# Every VITE_* value is inlined into the public browser bundle at build time,
# so only put PUBLIC values here. On Render, set the same keys under
# Environment before your build (see DEPLOYMENT.md).

# Supabase (optional until auth/data is wired)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sign-In (Google Identity Services, frontend only)
# Public Client ID — safe to expose in the browser bundle.
VITE_GOOGLE_CLIENT_ID=24300395823-u2fjcqaqai5j2dphrhdo0cbjjdisd4vn.apps.googleusercontent.com

# !!! NEVER put the Google Client SECRET in this repo or any VITE_* var !!!
# The client secret lives ONLY server-side:
#  - Supabase Dashboard > Authentication > Providers > Google, or
#  - your backend's secret store / env vars. Never commit it to git.

